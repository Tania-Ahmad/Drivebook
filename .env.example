# Leave VITE_API_URL unset in local development: Vite proxies /api to http://localhost:5000.
# In production set it to your deployed backend, e.g. https://api.drivebookee.com/api
VITE_API_URL=

# Public URL of the site (used for canonical links and social previews).
VITE_SITE_URL=https://drivebookee.com

# Sample-data demo buttons on the sign-in screen. Always on in development,
# OFF in production unless you set this to true.
VITE_ENABLE_DEMO=false
